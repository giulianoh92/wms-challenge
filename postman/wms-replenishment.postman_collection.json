{
	"info": {
		"_postman_id": "d822bf17-e67c-495a-905a-8688a083995c",
		"name": "WMS Replenishment Module",
		"description": "End-to-end circuit for the WMS replenishment module (SPECS.md). Run the whole collection top to bottom against a freshly started app (./run.sh) with the Collection Runner, or step through folders manually in order — later requests depend on state created by earlier ones within the same folder.\n\nFolders 2-4 use dedicated fixtures (PICK-99 / RSV-99 / SKU-900) so they never disturb the seeded SKU-100/SKU-200/SKU-300 scenario that folder 5 exercises. Folder 5 replays the exact walkthrough from README.md / docs/SRS.md §7, including the D4 idempotency check and the D6 guarantee that a task failing to confirm (insufficient stock) stays OPEN.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080/api/templates", "type": "string" },
		{ "key": "confirmTaskId", "value": "", "type": "string" },
		{ "key": "secondOpenTaskId", "value": "", "type": "string" },
		{ "key": "cancelTaskId", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "1. Seed Verification",
			"item": [
				{
					"name": "List Locations (seed)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const locations = pm.response.json();",
									"pm.test(\"Seed contains exactly 5 locations\", function () {",
									"    pm.expect(locations.length).to.eql(5);",
									"});",
									"",
									"const codes = locations.map(l => l.code).sort();",
									"pm.test(\"Seed locations match SPECS.md\", function () {",
									"    pm.expect(codes).to.eql([\"PICK-01\", \"PICK-02\", \"RSV-01\", \"RSV-02\", \"RSV-03\"]);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/locations",
							"host": [ "{{baseUrl}}" ],
							"path": [ "locations" ]
						}
					},
					"response": []
				},
				{
					"name": "List Stock (seed)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const stock = pm.response.json();",
									"pm.test(\"Seed contains exactly 6 stock records\", function () {",
									"    pm.expect(stock.length).to.eql(6);",
									"});",
									"",
									"function qty(sku, locationCode) {",
									"    const item = stock.find(i => i.sku === sku && i.locationCode === locationCode);",
									"    return item ? item.quantity : undefined;",
									"}",
									"",
									"pm.test(\"Seed quantities match SPECS.md\", function () {",
									"    pm.expect(qty(\"SKU-100\", \"PICK-01\")).to.eql(5);",
									"    pm.expect(qty(\"SKU-200\", \"PICK-01\")).to.eql(40);",
									"    pm.expect(qty(\"SKU-300\", \"PICK-02\")).to.eql(10);",
									"    pm.expect(qty(\"SKU-100\", \"RSV-01\")).to.eql(60);",
									"    pm.expect(qty(\"SKU-100\", \"RSV-02\")).to.eql(50);",
									"    pm.expect(qty(\"SKU-300\", \"RSV-03\")).to.eql(70);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/stock",
							"host": [ "{{baseUrl}}" ],
							"path": [ "stock" ]
						}
					},
					"response": []
				}
			]
		},
